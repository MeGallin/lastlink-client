{
  "name": "lastlink-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "npm run check:catalogue && npm run check:response && npm run check:route-flow && npm run check:active-journey && npm run check:answer && npm run check:pages && npm run typecheck && npm run lint && npm run build",
    "check:active-journey": "node --experimental-strip-types scripts/check-active-journey.mjs",
    "check:answer": "node scripts/check-answer.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:response": "node --experimental-strip-types scripts/check-response-shape.mjs",
    "check:route-flow": "node --experimental-strip-types scripts/check-route-flow.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
