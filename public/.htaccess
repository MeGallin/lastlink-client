# Keep the HTML shell and service worker fresh so a new deployment is visible
# without a manual cache purge. Fingerprinted build assets can be reused safely.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^[^/]+-[A-Za-z0-9_-]{8,}\.(?:js|css|woff2|svg|png|jpe?g|gif|webp|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(?:index\.html|manifest\.webmanifest|sw\.js|favicon\.svg|icon-192\.png|icon-512\.png)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
